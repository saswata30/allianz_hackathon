# =============================================================================
# Allianz Hackathon — central configuration
# Source this file (`source config/settings.env`) before running the shell/Python
# scripts, or export equivalents in your Databricks job. Every script reads these
# with sensible defaults, so you only change names in ONE place.
# =============================================================================

# --- Databricks workspace -----------------------------------------------------
export DATABRICKS_PROFILE="fe-vm-fevm-serverless-stable-xhky6g"
export DATABRICKS_HOST="https://fevm-serverless-stable-xhky6g.cloud.databricks.com"

# --- Unity Catalog (medallion + reference) ------------------------------------
export UC_CATALOG="allianz_hackathon"
export BRONZE_SCHEMA="bronze"
export SILVER_SCHEMA="silver"
export GOLD_SCHEMA="gold"
export REFERENCE_SCHEMA="reference"

# --- Lakebase (Autoscaling Postgres — OLTP landing) ---------------------------
export LB_PROJECT="allianz-hackathon"          # projects/<id>
export LB_BRANCH="production"
export LB_ENDPOINT="primary"
export LB_DATABASE="claims_db"                 # created inside the project
export LB_SCHEMA="claims"
export LB_TABLE="claim_transactions"
export LB_MIN_CU="0.5"
export LB_MAX_CU="2.0"

# --- Zero-copy: Lakebase registered into Unity Catalog (federation) -----------
export LAKEBASE_UC_CATALOG="lakebase_allianz"   # SELECT * FROM lakebase_allianz.claims.claim_transactions

# --- Generator behaviour ------------------------------------------------------
export GEN_INTERVAL_SECONDS="120"               # every 2 minutes
export GEN_MIN_ROWS="4"
export GEN_MAX_ROWS="5"

# --- SQL Warehouse for setup/dashboard SQL (fill in after you pick one) -------
# Find with: databricks warehouses list -p "$DATABRICKS_PROFILE"
export SQL_WAREHOUSE_ID=""
